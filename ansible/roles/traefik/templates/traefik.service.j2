[Unit]
Description=Traefik
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User={{ pa_traefik_user }}
Group={{ pa_traefik_user }}
ExecStart={{ pa_traefik_bin }} --configFile={{ pa_traefik_config_dir }}/traefik.yml
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target